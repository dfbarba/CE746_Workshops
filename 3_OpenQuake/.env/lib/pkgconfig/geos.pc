prefix=/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: GEOS
Description: Geometry Engine, Open Source - C API
Requires:
Version: 3.14.1
Cflags: -I${includedir}
Libs: -L${libdir} -lgeos_c
Libs.private: -lgeos -lstdc++ -lm

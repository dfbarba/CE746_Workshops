prefix=/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env
includedir=${prefix}/include
libdir=${prefix}/lib

gmodule_supported=true

Name: GModule
Description: Dynamic module loader for GLib
Version: 2.90.0
Requires: glib-2.0
Libs: -L${libdir} -lgmodule-2.0
Libs.private: -lintl
Cflags: -I${includedir}

CONFIG_VERSION=3.13.3
CONFIG_INST_PREFIX=/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env
CONFIG_INST_LIBS=-L/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env/lib -lgdal
CONFIG_INST_CFLAGS=-I/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env/include
CONFIG_INST_DATA=/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env/share/gdal
prefix=${CONFIG_INST_PREFIX}
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${exec_prefix}/include
datadir=${CONFIG_INST_DATA}

Name: libgdal
Description: Geospatial Data Abstraction Library
Version: ${CONFIG_VERSION}
Libs: ${CONFIG_INST_LIBS}
Libs.private: -larchive -liconv -lssl -lcrypto -llz4 -llzma -lmuparser -ldeflate -lLerc -lzstd -ljpeg -lpng -lgif -lblosc -lwebp -ljxl -ljxl_threads -lkmlbase -lkmldom -lkmlengine -lminizip -luriparser -lpcre2-8 -lspatialite -lsqlite3 -lxerces-c -lexpat.1 -lxml2 -lgeos_c.1.20.5 -lcurl -lomp -lproj.25.9.9.0 -ljson-c.5.4.0 -lm -lz -lc++
Cflags: ${CONFIG_INST_CFLAGS}

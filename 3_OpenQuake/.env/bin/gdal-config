#!/bin/sh
CONFIG_LIBS="-L/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env/lib -lgdal"
CONFIG_DEP_LIBS="-larchive -liconv -lssl -lcrypto -llz4 -llzma -lmuparser -ldeflate -lLerc -lzstd -ljpeg -lpng -lgif -lblosc -lwebp -ljxl -ljxl_threads -lkmlbase -lkmldom -lkmlengine -lminizip -luriparser -lpcre2-8 -lspatialite -lsqlite3 -lxerces-c -lexpat.1 -lxml2 -lgeos_c.1.20.5 -lcurl -lomp -lproj.25.9.9.0 -ljson-c.5.4.0 -lm -lz -lc++"
CONFIG_PREFIX="/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env"
CONFIG_CFLAGS="-I/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env/include"
CONFIG_DATA="/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env/share/gdal"
CONFIG_VERSION="3.13.3"
CONFIG_GNM_ENABLED=yes
CONFIG_FORMATS="JPEG raw GTIFF MEM vrt Derived GTI LIBERTIFF HFA NITF GXF AAIGrid CEOS SAR_CEOS DTED JDEM Envisat L1B RS2 ILWIS RMF Leveller SRTMHGT IDRISI GSG ERS PALSARJaxa DIMAP GFF COSAR PDS ADRG COASP TSX Terragen MSGN TIL northwood SAGA XYZ AVIF HEIF ESRIC HF2 KMLSUPEROVERLAY CTG ZMap NGSGEOID IRIS MAP CALS SAFE SENTINEL2 PRF MRF WMTS GRIB BMP TGA STACTA SNAP_TIFF BSB AIGrid USGSDEM AirSAR PCIDSK SIGDEM RIK STACIT PDF RCM GDALG E57 PNG GIF WCS HTTP netCDF Zarr DAAS EEDA FITS HDF5 PLMOSAIC WMS OGCAPI WEBP HDF4 MBTiles PostGISRaster KEA JP2OpenJPEG TileDB PCRaster JPEGXL MiraMon GeoJSON TAB Shape KML VRT AVC GML CSV DGN GMT NTF S57 Tiger GeoRSS DXF PGDump GPSBabel EDIGEO SXF OpenFileGDB WAsP Selafin JML VDV FlatGeobuf MapML ADBC MiraMon AIVector JSONFG GPX GMLAS CSW LIBKML NAS PLSCENES WFS OAPIF NGW Elastic Idrisi PDS SQLite GeoPackage OSM VFK MVT PMTiles AmigoCloud Carto ILI PG XLSX XLS CAD Parquet Arrow GTFS ODS LVBAG"
CONFIG_PLUGINDIR="/Users/dfbarbag/Documents/Projects/00_CE746_Workshops/3_OpenQuake/.env/lib/gdalplugins"
usage()

{
	cat <<EOF
Usage: gdal-config [OPTIONS]
Options:
	[--prefix[=DIR]]
	[--libs]
	[--dep-libs]
	[--cflags]
	[--datadir]
	[--version]
	[--ogr-enabled]
	[--gnm-enabled]
	[--formats]
	[--plugindir]
EOF
	exit $1
}

if test $# -eq 0; then
	usage 1 1>&2
fi

case $1 in
  --libs)
    echo $CONFIG_LIBS
    ;;

  --dep-libs)
    echo $CONFIG_DEP_LIBS
    ;;

  --cflags)
    echo $CONFIG_CFLAGS
    ;;

  --datadir)
    echo $CONFIG_DATA
    ;;

  --prefix)
    echo $CONFIG_PREFIX
    ;;

  --version)
    echo $CONFIG_VERSION
    ;;

  --ogr-enabled)
    echo yes
    ;;

  --gnm-enabled)
    echo $CONFIG_GNM_ENABLED
    ;;

  --formats)
    echo $CONFIG_FORMATS
    ;;

  --plugindir)
    echo $CONFIG_PLUGINDIR
    ;;

  *)
    usage 1 1>&2
    ;;

esac
